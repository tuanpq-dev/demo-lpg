# Mẫu biến môi trường frontend – copy thành .env rồi điền. KHÔNG commit .env.
# Backend nằm ở repo riêng (../demo-lpg-server, có .env.example của nó).

# api (mặc định) = đăng nhập qua backend · off = không đăng nhập, phiên giả "admin" (chỉ để demo tĩnh/Netlify, không có backend).
VITE_AUTH=api
# Gốc URL API phía trình duyệt (mặc định /api – Vite dev proxy chuyển tới backend).
VITE_API_URL=/api
# Đích proxy của Vite dev/preview (mặc định http://localhost:3000).
VITE_API_PROXY=http://localhost:3000
